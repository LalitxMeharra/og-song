/* Dark theme with glass-morphism */
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: #0d0d0d;
    color: #ffffff;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 20px;
}

.container {
    max-width: 800px;
    width: 100%;
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 30px;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
}

/* Search bar */
.search-section {
    display: flex;
    gap: 12px;
    margin: 24px 0;
}
.search-section input {
    flex: 1;
    padding: 14px 20px;
    border: 2px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    background: rgba(255,255,255,0.06);
    color: #fff;
    font-size: 16px;
    transition: 0.3s;
}
.search-section input:focus {
    border-color: #ff6b00;
    outline: none;
}
.search-section button {
    padding: 14px 28px;
    background: linear-gradient(135deg, #ff6b00, #ff4500);
    border: none;
    border-radius: 12px;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s;
}
.search-section button:hover {
    transform: scale(1.05);
}

/* Result card */
.result-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255,255,255,0.04);
    border-radius: 16px;
    padding: 14px 20px;
    margin: 12px 0;
    transition: 0.3s;
    border: 1px solid rgba(255,255,255,0.04);
}
.result-card:hover {
    background: rgba(255,255,255,0.08);
}
.result-card img {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
}
.result-card .info {
    flex: 1;
}
.result-card .title {
    font-weight: 600;
    font-size: 16px;
}
.result-card .artist {
    font-size: 14px;
    opacity: 0.6;
}
.result-card .actions {
    display: flex;
    gap: 8px;
}
.result-card .actions button {
    padding: 8px 12px;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: 0.2s;
}
.btn-play { background: #00c853; color: #fff; }
.btn-download { background: #ff6b00; color: #fff; }
.btn-download:hover { background: #ff4500; }
.btn-play:hover { background: #00a844; }

/* Spinner */
.loading { text-align: center; padding: 40px; }
.spinner {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(255,255,255,0.1);
    border-top: 4px solid #ff6b00;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 16px;
}
@keyframes spin { 100% { transform: rotate(360deg); } }

/* Player */
.player {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.95);
    backdrop-filter: blur(10px);
    padding: 16px 24px;
    border-top: 1px solid rgba(255,255,255,0.1);
}
.player-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}
#closePlayer { cursor: pointer; opacity: 0.6; }
#closePlayer:hover { opacity: 1; }
audio { width: 100%; }

/* Responsive */
@media (max-width: 600px) {
    .search-section { flex-direction: column; }
    .result-card { flex-wrap: wrap; }
    .result-card .actions { margin-top: 8px; flex-wrap: wrap; }
  }
